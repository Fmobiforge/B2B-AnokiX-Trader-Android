<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        One tile in the Wallet's Quick Actions grid. The tiles sit inside a single card
        (as on the portal), so they carry no card chrome of their own — only a ripple.
    -->
    <style name="WalletAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="InvStatTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_card_white</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="InvStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="InvStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Portal-style stat card (horizontal scroll row) -->
    <style name="InvStatCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">150dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="InvStatCardInner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="InvStatCardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="InvStatCardValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- GRV confirm-sheet per-line column header (ORDERED / RECEIVED / …). -->
    <style name="GrvColLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- GRV KPI card: icon tile above value + label (mirrors the portal stat cards). -->
    <style name="GrvStatCardInner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="GrvStatIconTile">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_grv_icon_tile</item>
    </style>

    <style name="GrvStatIcon">
        <item name="android:layout_width">21dp</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <!-- One cell in the 2x2 KPI grid (half width, equal weight). -->
    <style name="GrvStatCell" parent="InvStatCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <!-- Inventory dashboard section card + title. -->
    <style name="InvSectionCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card_white</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="InvSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Return Goods form: section label + tappable field. -->
    <style name="ReturnFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ReturnFieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_grv_input</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WalletActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Theme.AnokiXDistributor" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- App is light-only; block system "force dark" from auto-inverting colors. -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/purple_primary</item>
        <!-- Portal-style white top bar: white status bar with dark icons. -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialCardViewStyle">@style/Widget.AnokiX.Card</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AnokiX.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AnokiX.Medium</item>
    </style>

    <style name="Theme.AnokiXDistributor.Login" parent="Theme.AnokiXDistributor">
        <item name="android:statusBarColor">@color/login_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
        POS Scan / QR sheet. Full-width with a rounded card so the camera preview has
        room on a phone, and the window is not dimmed away from the goods being scanned.
    -->
    <style name="Theme.AnokiX.Dialog.Scan" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@drawable/bg_scan_dialog</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.AnokiX.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.AnokiX.Medium</item>
    </style>

    <style name="Widget.AnokiX.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">@dimen/spacing_lg</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border</item>
    </style>

    <style name="Widget.AnokiX.Card.Flat" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">@dimen/spacing_md</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border</item>
    </style>

    <style name="ShapeAppearance.AnokiX.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.AnokiX.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <!-- Fully round image (marketplace story thumbnails). -->
    <style name="ShapeAppearance.AnokiX.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Portal page header: white bar, hairline bottom border, navy title + icons. -->
    <style name="Widget.AnokiX.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@drawable/bg_header_divider</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="titleTextAppearance">@style/TextAppearance.AnokiX.ToolbarTitle</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:theme">@style/ThemeOverlay.AnokiX.Toolbar</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Light</item>
    </style>

    <style name="ThemeOverlay.AnokiX.Toolbar" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.AnokiX.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Widget.AnokiX.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.AnokiX.Button.Outlined.Success" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/success</item>
        <item name="android:textColor">@color/success</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.AnokiX.Button.Outlined.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/danger</item>
        <item name="android:textColor">@color/danger</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="TextAppearance.AnokiX.BottomNav" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/bottom_nav_text_size</item>
    </style>

    <style name="TextAppearance.AnokiX.BottomNav.Active" parent="TextAppearance.AnokiX.BottomNav">
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.AnokiX.SettingsCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border</item>
    </style>

    <style name="Widget.AnokiX.SettingsCardBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.AnokiX.SettingsSectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.AnokiX.SettingsSectionSubtitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.AnokiX.SettingsSaveButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/purple_primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Business-profile step scaffolding -->
    <style name="BizStepBody" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">16dp</item>
    </style>

    <style name="BizStepTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/top_title</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="BizStepSub" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Business-profile pseudo-dropdown (bg_login_input box + label + chevron) -->
    <style name="BizDropdownBox" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_login_input</item>
        <item name="android:paddingHorizontal">14dp</item>
    </style>

    <style name="BizDropdownLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical|start</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BizDropdownChevron" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_gravity">center_vertical|end</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:rotation">90</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/text_secondary</item>
    </style>

    <!-- Service distribution-coverage selectable card -->
    <style name="CoverageCard" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">84dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_trader_type_card</item>
    </style>

    <style name="CoverageTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CoverageSub" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.AnokiX.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/nav_icon_color</item>
        <item name="itemTextColor">@color/nav_icon_color</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.AnokiX.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.AnokiX.BottomNav</item>
        <item name="itemIconSize">22dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
        <item name="android:background">@drawable/bg_bottom_nav</item>
    </style>

    <!-- Staff sheets: field label, its red required marker, and the input box. -->
    <style name="StaffFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="StaffRequiredMarker" parent="StaffFieldLabel">
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="StaffFieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_filter_pill</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
