<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <!-- Logo area in the dark header (mirrors the login screen) -->
    <LinearLayout
        android:id="@+id/logoArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintBottom_toTopOf="@id/resetCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <com.anokix.traderapp.ui.views.ResizableImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_anokix_logo" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_subtitle"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_headline" />
    </LinearLayout>

    <!-- White bottom sheet card -->
    <LinearLayout
        android:id="@+id/resetCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_login_card_top"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- ==== Form state ==== -->
        <LinearLayout
            android:id="@+id/formState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_password_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_headline" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/reset_password_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/email_address_label"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_login_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_email" />

                <com.anokix.traderapp.ui.views.RobotoEditText
                    android:id="@+id/emailInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="cong@anokix.co.za"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/sendButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_welcome_login_gradient"
                android:gravity="center"
                android:text="@string/send_reset_link"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:id="@+id/backToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp"
                android:text="@string/back_to_login"
                android:textColor="@color/purple_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ==== Sent / confirmation state ==== -->
        <LinearLayout
            android:id="@+id/sentState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_success_circle"
                android:contentDescription="@null"
                android:padding="16dp"
                android:src="@drawable/ic_check_white" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/reset_sent_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_headline" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:id="@+id/sentMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/reset_sent_message"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/backToLoginPrimary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_welcome_login_gradient"
                android:gravity="center"
                android:text="@string/back_to_login"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/resendButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_login_button_outlined"
                android:gravity="center"
                android:orientation="horizontal">

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:id="@+id/resendLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resend_link"
                    android:textColor="@color/purple_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
