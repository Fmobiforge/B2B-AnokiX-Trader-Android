<?xml version="1.0" encoding="utf-8"?>
<!--
  anokiX wallet (powered by IMB). A screen of its own rather than a tab, so it can be
  opened from anywhere — the drawer, the dashboard card, a top-up return — and closed
  back to wherever the trader came from.

  Stacked in the reading order of the portal's wallet page (wallet01.png): the balance
  card, the settlement account behind it, what you can do from here, then the two
  ledgers — recent movements and standing debit orders.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.AnokiX.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/anokix_wallet"
        app:titleTextColor="@color/text_primary" />

    <!--
      The strapline sits under the bar rather than inside it as a toolbar subtitle. In
      the bar it shares its width with the back arrow and ellipsises; here it has the
      whole screen and can wrap. Same treatment as Finances / Staff / Invoices.
    -->
    <com.anokix.traderapp.ui.views.RobotoTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:text="@string/wallet_header_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <!-- ==== Balance card (wallet02.png) ==== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_wallet_balance"
                    android:elevation="3dp"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.traderapp.ui.views.RobotoTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wallet_total_balance"
                            android:textColor="#E9DDFF"
                            android:textSize="13sp" />

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp">

                            <ImageButton
                                android:id="@+id/walletRefresh"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_wallet_glass_btn"
                                android:contentDescription="@string/wallet_refresh"
                                android:padding="8dp"
                                android:src="@drawable/ic_refresh"
                                app:tint="#FFFFFF" />

                            <ProgressBar
                                android:id="@+id/walletRefreshProgress"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="#FFFFFF"
                                android:visibility="gone" />
                        </FrameLayout>

                        <ImageButton
                            android:id="@+id/walletHide"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_wallet_glass_btn"
                            android:contentDescription="@string/wallet_hide_balance"
                            android:padding="8dp"
                            android:src="@drawable/ic_visibility"
                            app:tint="#FFFFFF" />
                    </LinearLayout>

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/walletBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/wallet_amount_placeholder"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.anokix.traderapp.ui.views.RobotoTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/available_balance"
                                android:textColor="#D6C4FF"
                                android:textSize="11sp" />

                            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                                android:id="@+id/walletAvailable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/wallet_amount_placeholder"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.anokix.traderapp.ui.views.RobotoTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/wallet_pending"
                                android:textColor="#D6C4FF"
                                android:textSize="11sp" />

                            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                                android:id="@+id/walletPending"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/wallet_amount_placeholder"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/walletAsOf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/wallet_as_of_placeholder"
                        android:textColor="#C9B6FF"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <!-- Shown instead of Top Up when the wallet is not active yet. -->
                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/walletNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_wallet_glass_btn"
                        android:lineSpacingExtra="2dp"
                        android:padding="12dp"
                        android:text="@string/wallet_not_configured"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTopUp"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#FFFFFF"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/wallet_top_up"
                        android:textColor="@color/purple_primary"
                        android:textSize="15sp"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_add"
                        app:iconGravity="textStart"
                        app:iconTint="@color/purple_primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_wallet_card_rule" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.traderapp.ui.views.RobotoTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wallet_card_footer"
                            android:textColor="#D6C4FF"
                            android:textSize="10sp" />

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/walletStatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_wallet_glass_btn"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="@string/wallet_status_active"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ==== Settlement account ==== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp">

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wallet_settlement_account"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Pale tile, saturated glyph. The tile tint must stay far
                             lighter than the icon tint or the icon vanishes into it. -->
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_icon_circle"
                            android:backgroundTint="@color/purple_light"
                            android:contentDescription="@null"
                            android:padding="11dp"
                            android:src="@drawable/ic_wallet"
                            app:tint="@color/purple_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/wallet_imb_account"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <com.anokix.traderapp.ui.views.RobotoTextView
                                android:id="@+id/walletAccountNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:letterSpacing="0.04"
                                android:text="@string/em_dash"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/btnCopyAccount"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/wallet_copy_account"
                            android:padding="8dp"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/purple_primary" />
                    </LinearLayout>

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/walletActivated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewStatement"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/wallet_view_statement"
                        android:textColor="@color/purple_primary"
                        android:textSize="14sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/purple_primary" />
                </LinearLayout>

                <!-- ==== Quick actions ==== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="14dp">

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="@string/wallet_quick_actions"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/actionAdd"
                            style="@style/WalletAction">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="@color/success_bg"
                                android:contentDescription="@null"
                                android:padding="13dp"
                                android:src="@drawable/ic_add"
                                app:tint="@color/success" />

                            <com.anokix.traderapp.ui.views.RobotoTextView
                                style="@style/WalletActionLabel"
                                android:text="@string/add_money" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/actionDebitOrder"
                            style="@style/WalletAction">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="@color/info_bg"
                                android:contentDescription="@null"
                                android:padding="13dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/info" />

                            <com.anokix.traderapp.ui.views.RobotoTextView
                                style="@style/WalletActionLabel"
                                android:text="@string/wallet_action_debit_order" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/actionAirtime"
                            style="@style/WalletAction">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="@color/warning_bg"
                                android:contentDescription="@null"
                                android:padding="13dp"
                                android:src="@drawable/ic_vas"
                                app:tint="@color/warning" />

                            <com.anokix.traderapp.ui.views.RobotoTextView
                                style="@style/WalletActionLabel"
                                android:text="@string/buy_airtime" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/actionStatement"
                            style="@style/WalletAction">

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/bg_icon_circle"
                                android:backgroundTint="@color/purple_light"
                                android:contentDescription="@null"
                                android:padding="13dp"
                                android:src="@drawable/ic_document"
                                app:tint="@color/purple_primary" />

                            <com.anokix.traderapp.ui.views.RobotoTextView
                                style="@style/WalletActionLabel"
                                android:text="@string/statement" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ==== Recent transactions ==== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/recent_transactions"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/btnViewAllTxns"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:padding="4dp"
                            android:text="@string/view_all"
                            android:textColor="@color/purple_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/txnContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="vertical" />

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/txnEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="22dp"
                        android:text="@string/wallet_no_transactions"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ==== Debit orders ==== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_white"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wallet_debit_orders"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/btnNewDebitOrder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:padding="4dp"
                            android:text="@string/wallet_new_debit_order"
                            android:textColor="@color/purple_primary"
                            android:textSize="13sp"
                            app:drawableStartCompat="@drawable/ic_add"
                            app:drawableTint="@color/purple_primary" />
                    </LinearLayout>

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/debitHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/wallet_debit_orders_help"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/debitContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/debitEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="22dp"
                        android:text="@string/wallet_no_debit_orders"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
