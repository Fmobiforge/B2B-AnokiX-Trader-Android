<?xml version="1.0" encoding="utf-8"?>
<!--
  Airtime & VAS. Mirrors the web portal: KPI strip + "how this page works" explainer, a
  scrollable tab bar, and one visible section at a time (onboard → subscription →
  catalog/dynamic → transactions).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.AnokiX.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/airtime_vas"
        app:titleTextColor="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/vasScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vas_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- KPI grid (2x2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vas_kpi_spend_today"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/kpiSpendToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/success"
                        android:textSize="16sp"
                        tools:text="R 0,00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vas_kpi_txn_today"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/kpiTxnToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        tools:text="0" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vas_kpi_month"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/kpiMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/success"
                        android:textSize="16sp"
                        tools:text="R 0,00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vas_kpi_wallet"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/kpiWallet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/purple_primary"
                        android:textSize="16sp"
                        tools:text="R 100 000,00" />
                </LinearLayout>
            </LinearLayout>

            <!-- How this page works -->
            <com.anokix.traderapp.ui.views.RobotoTextView
                android:id="@+id/vasHowItWorks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_vas_info_banner"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:text="@string/vas_how_it_works"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <!-- Tabs -->
            <HorizontalScrollView
                android:id="@+id/vasTabScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/vasTabStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!--
              "Acting as" + its gate. Both belong to the three customer-scoped tabs
              (Subscription, Catalog & orders, Dynamic services) and are hidden elsewhere; the
              selection is shared, so switching between those tabs keeps the same customer.
            -->
            <include
                android:id="@+id/vasActingAs"
                layout="@layout/include_vas_acting_as"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:id="@+id/vasGateCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_stat_card"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="34dp"
                android:text="@string/vas_select_customer_gate"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Sections — exactly one is visible at a time -->
            <include
                android:id="@+id/sectionOnboard"
                layout="@layout/include_vas_onboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <include
                android:id="@+id/sectionCustomers"
                layout="@layout/include_vas_customers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <include
                android:id="@+id/sectionSubscription"
                layout="@layout/include_vas_subscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <include
                android:id="@+id/sectionCatalog"
                layout="@layout/include_vas_catalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <include
                android:id="@+id/sectionDynamic"
                layout="@layout/include_vas_dynamic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <include
                android:id="@+id/sectionTransactions"
                layout="@layout/include_vas_transactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
