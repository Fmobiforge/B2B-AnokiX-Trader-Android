<?xml version="1.0" encoding="utf-8"?>
<!-- Best Sellers row: distributor initial/logo, name, YOURS badge, catalogue size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/sellerAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_round_avatar"
            android:gravity="center"
            android:textColor="@color/brand_blue"
            android:textSize="14sp"
            tools:text="S" />

        <ImageView
            android:id="@+id/sellerAvatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/sellerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="Sunrise Wholesale" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/sellerYours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_stock_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="@string/market_yours"
                android:textColor="@color/success_strong"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/sellerCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="10 products" />
    </LinearLayout>
</LinearLayout>
