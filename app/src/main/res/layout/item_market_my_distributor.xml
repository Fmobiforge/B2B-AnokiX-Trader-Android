<?xml version="1.0" encoding="utf-8"?>
<!-- My Distributors card: identity, catalogue size, coverage area, View Distributor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/mdAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_dist_avatar"
                android:gravity="center"
                android:textColor="@color/purple_primary"
                android:textSize="16sp"
                tools:text="A" />

            <ImageView
                android:id="@+id/mdAvatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/mdName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="ApplePay" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/market_products_available"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/mdProducts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="10+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="1dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/text_secondary" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/market_coverage_area"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/mdCoverage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="Johannesburg Road, La Rochelle, Johannesburg South" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mdView"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/market_view_distributor"
        android:textAllCaps="false"
        android:textColor="@color/brand_blue"
        android:textSize="13sp"
        app:cornerRadius="8dp"
        app:strokeColor="@color/brand_blue" />
</LinearLayout>
