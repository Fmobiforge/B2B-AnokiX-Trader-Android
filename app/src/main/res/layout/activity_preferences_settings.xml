<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.AnokiX.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Preferences"
        app:titleTextColor="@color/text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AnokiX.SettingsCard">

            <LinearLayout style="@style/Widget.AnokiX.SettingsCardBody">

                <com.anokix.traderapp.ui.views.RobotoBoldTextView
                    style="@style/Widget.AnokiX.SettingsSectionTitle"
                    android:text="Preferences" />

                <com.anokix.traderapp.ui.views.RobotoTextView
                    style="@style/Widget.AnokiX.SettingsSectionSubtitle"
                    android:text="Configure language, currency and regional settings." />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Language"
                    app:boxStrokeColor="@color/purple_primary"
                    app:hintTextColor="@color/purple_primary">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Currency"
                    app:boxStrokeColor="@color/purple_primary"
                    app:hintTextColor="@color/purple_primary">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddCurrency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Timezone"
                    app:boxStrokeColor="@color/purple_primary"
                    app:hintTextColor="@color/purple_primary">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddTimezone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Date Format"
                    app:boxStrokeColor="@color/purple_primary"
                    app:hintTextColor="@color/purple_primary">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddDateFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Airtime & VAS payment. The web shows the explanation in a "?" tooltip;
                     on mobile it reads better as persistent helper text under the field. -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/vas_payment_label"
                    app:boxStrokeColor="@color/purple_primary"
                    app:helperText="@string/vas_payment_helper"
                    app:helperTextEnabled="true"
                    app:hintTextColor="@color/purple_primary">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/ddVasPayment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <include layout="@layout/include_settings_footer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
