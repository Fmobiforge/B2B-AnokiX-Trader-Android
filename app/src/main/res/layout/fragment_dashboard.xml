<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- White header with hamburger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/hamburgerButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_menu"
            android:src="@drawable/ic_hamburger"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_back_generic"
                android:textAppearance="@style/TextAppearance.AnokiX.Title" />

            <com.anokix.traderapp.ui.views.RobotoLightTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/dashboard_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/cartButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <!-- 24dp glyph centred in the 40dp touch target — the same pairing the
                 hamburger and bell get. Those two are ImageButtons, whose default style
                 is scaleType="center" (glyph stays at its intrinsic 24dp); an ImageView
                 defaults to fitCenter and would blow the same drawable up to the full
                 40dp box, which is why the cart used to tower over the bell. Size the
                 view, don't lean on the widget default. -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cart"
                android:src="@drawable/ic_cart"
                app:tint="@color/text_primary" />

            <!-- Pill (not the bell's fixed oval): cart quantities run past 9 into "99+". -->
            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/cartBadge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_pill_new"
                android:gravity="center"
                android:minWidth="16dp"
                android:paddingHorizontal="4dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp">

            <ImageButton
                android:id="@+id/notificationsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notifications"
                android:src="@drawable/ic_notifications"
                app:tint="@color/text_primary" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/notificationBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_notification_badge"
                android:gravity="center"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />
        </FrameLayout>

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/profileInitial"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_profile_circle"
            android:gravity="center"
            android:text="A"
            android:textColor="@color/purple_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============ Row 1: Today's Sales + Pending Orders ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Today's Sales -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:contentPadding="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_reports"
                                app:tint="@color/brand_blue" />

                            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/todays_sales"
                                android:textColor="@color/top_title"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/salesAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp" />

                        <com.anokix.traderapp.ui.views.RobotoTextView
                            android:id="@+id/salesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/sales_today_zero"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <com.anokix.traderapp.ui.views.RobotoLightTextView
                            android:id="@+id/salesItems"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0 items"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/salesTrend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_growth_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="↑ 0.0%"
                            android:textColor="@color/success"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pending Orders -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:contentPadding="0dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_package"
                                app:tint="@color/warning" />

                            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/pending_orders"
                                android:textColor="@color/top_title"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/pendingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp" />

                        <com.anokix.traderapp.ui.views.RobotoTextView
                            android:id="@+id/pendingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/total_value_placeholder"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/pendingViewOrders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn_dash_orange"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:text="@string/view_orders"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ==================== anokiX wallet ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:contentPadding="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/anokix_wallet"
                                android:textColor="@color/top_title"
                                android:textSize="14sp" />

                            <com.anokix.traderapp.ui.views.RobotoLightTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/wallet_subtitle"
                                android:textColor="@color/text_tertiary"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/walletStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_badge_success"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Active"
                            android:textColor="@color/success"
                            android:textSize="10sp"
                            android:visibility="gone" />

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="8dp">

                            <ImageButton
                                android:id="@+id/walletRefresh"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/wallet_refresh"
                                android:padding="6dp"
                                android:src="@drawable/ic_refresh"
                                app:tint="@color/brand_blue" />

                            <ProgressBar
                                android:id="@+id/walletRefreshProgress"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="@color/purple_primary"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/available_balance"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/walletAvailable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp" />

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/walletBreakdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=" "
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <com.anokix.traderapp.ui.views.RobotoLightTextView
                        android:id="@+id/walletAsOf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text=" "
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/walletAddMoney"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_dash_primary"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:text="@string/add_money"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/walletSendMoney"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_dash_outline"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:text="@string/dash_send_money"
                            android:textColor="@color/brand_blue"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/walletViewTransactions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/view_transactions"
                        android:textColor="@color/brand_blue"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== anokiX rewards ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:contentPadding="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/anokix_rewards"
                        android:textColor="@color/top_title"
                        android:textSize="14sp" />

                    <com.anokix.traderapp.ui.views.RobotoLightTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/rewards_subtitle"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.anokix.traderapp.ui.views.RobotoTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/rewards_points"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                                android:id="@+id/rewardsPoints"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="—"
                                android:textColor="@color/text_primary"
                                android:textSize="26sp" />

                            <com.anokix.traderapp.ui.views.RobotoTextView
                                android:id="@+id/rewardsEarned"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text=" "
                                android:textColor="@color/success"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <com.anokix.traderapp.ui.views.RobotoLightTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/rewards_value"
                                android:textColor="@color/text_tertiary"
                                android:textSize="10sp" />

                            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                                android:id="@+id/rewardsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="—"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/rewardsViewRewards"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_btn_dash_green"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="9dp"
                            android:text="@string/view_rewards"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/rewardsViewHistory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="@string/view_history"
                            android:textColor="@color/success"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== Quick Actions ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:contentPadding="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quick_actions"
                        android:textColor="@color/top_title"
                        android:textSize="14sp" />

                    <GridLayout
                        android:id="@+id/quickActionsGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:columnCount="3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== Promotions carousel ==================== -->
            <LinearLayout
                android:id="@+id/promotionsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dash_promotions"
                        android:textColor="@color/top_title"
                        android:textSize="14sp" />

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/promotionsViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_all"
                        android:textColor="@color/purple_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ViewPager2 cannot measure wrap_content; the slide is designed to this height. -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/promotionsPager"
                    android:layout_width="match_parent"
                    android:layout_height="292dp" />

                <LinearLayout
                    android:id="@+id/promotionsIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- ==================== Recent Orders ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:contentPadding="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/recent_orders"
                            android:textColor="@color/top_title"
                            android:textSize="14sp" />

                        <com.anokix.traderapp.ui.views.RobotoTextView
                            android:id="@+id/recentOrdersViewAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/view_all"
                            android:textColor="@color/purple_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recentOrdersList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/recentOrdersEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:text="@string/no_recent_orders"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== Top Selling Products ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:contentPadding="0dp"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/top_products"
                        android:textColor="@color/top_title"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/topProductsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/topProductsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:text="@string/no_sales_this_week"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==================== Unlock bigger rewards banner ==================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_promo_banner_purple"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unlock_rewards_title"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/unlock_rewards_sub"
                        android:textColor="#E8E0FF"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/rewardsProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:max="10"
                        android:progress="8"
                        android:progressBackgroundTint="#000511"
                        android:progressTint="#8b5cf6" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.anokix.traderapp.ui.views.RobotoTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/rewards_progress_label"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp" />

                        <com.anokix.traderapp.ui.views.RobotoBoldTextView
                            android:id="@+id/bannerViewRewards"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_white"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:text="@string/view_rewards"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
