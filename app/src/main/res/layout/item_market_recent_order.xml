<?xml version="1.0" encoding="utf-8"?>
<!-- Recent Orders row: order number + date on the left, status pill on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/roNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="#ORD000046" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/roDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="15/09/2026 11:50:12" />
    </LinearLayout>

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/roStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_warning"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:textColor="@color/warning"
        android:textSize="10sp"
        tools:text="Pending" />
</LinearLayout>
