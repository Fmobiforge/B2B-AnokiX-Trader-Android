<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required to show push notifications on Android 13+ (runtime-requested). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Confirmation tick when the POS scanner reads a code. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
        Android 11+ package visibility. Without these the Support Centre cannot tell
        whether WhatsApp is installed, and the Reports screen cannot resolve a viewer
        for a downloaded CSV.
    -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />

        <!--
            PayCloud's cashier app (WiseCashier) on a POS terminal. Without this the
            till cannot see that it is running on a card machine, and card sales would
            always be pushed to a separate terminal instead of taken on this one.
        -->
        <intent>
            <action android:name="com.wiseasy.transaction.call" />
        </intent>

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="text/csv" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AnokiXDistributor">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="@string/google_maps_key" />

        <!-- Firebase Cloud Messaging: receives push tokens + messages. -->
        <service
            android:name=".messaging.AxFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Defaults applied to notifications that arrive while the app is backgrounded. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/purple_primary" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/fcm_default_channel_id" />

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AnokiXDistributor.Login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.AnokiXDistributor.Login" />

        <activity
            android:name=".ui.RegisterTraderActivity"
            android:exported="false"
            android:theme="@style/Theme.AnokiXDistributor"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.RegisterSubmittedActivity"
            android:exported="false"
            android:theme="@style/Theme.AnokiXDistributor.Login" />

        <activity
            android:name=".ui.PendingApprovalActivity"
            android:exported="false"
            android:theme="@style/Theme.AnokiXDistributor.Login" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.AnokiXDistributor.Login">
        </activity>

        <activity
            android:name=".ui.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.AnokiXDistributor.Login"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.MainActivity"
            android:launchMode="singleTop"
            android:exported="false" />

        <activity android:name=".ui.ReportsActivity" android:exported="false" />
        <activity
            android:name=".ui.StaffActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.NotificationsActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.ProfileSettingsActivity" android:exported="false" />
        <activity android:name=".ui.NotificationSettingsActivity" android:exported="false" />
        <activity android:name=".ui.SecuritySettingsActivity" android:exported="false" />
        <activity android:name=".ui.PreferencesSettingsActivity" android:exported="false" />
        <activity android:name=".ui.BusinessProfileActivity" android:exported="false" />

        <!-- Trader modules -->
        <activity android:name=".ui.CheckoutActivity" android:exported="false" />
        <activity android:name=".ui.SalesActivity" android:exported="false" />
        <activity android:name=".ui.OrderDetailActivity" android:exported="false" />
        <activity android:name=".ui.InventoryActivity" android:exported="false" />
        <activity android:name=".ui.StockHistoryActivity" android:exported="false" />
        <activity android:name=".ui.InventoryAnalyticsActivity" android:exported="false" />
        <activity android:name=".ui.GoodsReceivedActivity" android:exported="false" />
        <activity android:name=".ui.InvoicesActivity" android:exported="false" />
        <activity android:name=".ui.FinancesActivity" android:exported="false" />
        <activity android:name=".ui.DistributorsActivity" android:exported="false" />
        <activity android:name=".ui.DistributorDetailActivity" android:exported="false" />
        <activity android:name=".ui.GoodsReturnsActivity" android:exported="false" />
        <activity android:name=".ui.GoodsReturnFormActivity" android:exported="false" />
        <activity android:name=".ui.PdfViewerActivity" android:exported="false" />
        <activity android:name=".ui.MarketplaceActivity" android:exported="false" />
        <activity android:name=".ui.AllCategoriesActivity" android:exported="false" />
        <activity android:name=".ui.CategoryProductsActivity" android:exported="false" />
        <activity android:name=".ui.CollectionActivity" android:exported="false" />
        <activity android:name=".ui.PromotionsActivity" android:exported="false" />
        <activity android:name=".ui.ProductDetailActivity" android:exported="false" />
        <activity android:name=".ui.CartActivity" android:exported="false" />
        <activity android:name=".ui.MakeOrderActivity" android:exported="false" />
        <activity android:name=".ui.AddressPickerActivity" android:exported="false" />
        <activity android:name=".ui.PaymentsActivity" android:exported="false" />
        <activity android:name=".ui.AirtimeActivity" android:exported="false" />
        <activity android:name=".ui.RewardsActivity" android:exported="false" />
        <activity android:name=".ui.CustomersActivity" android:exported="false" />
        <activity android:name=".ui.AnalyticsActivity" android:exported="false" />
        <activity android:name=".ui.SupportActivity" android:exported="false" />
        <activity
            android:name=".ui.SupportTicketActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.OffersActivity" android:exported="false" />

        <!--
            The anokiX wallet. singleTop so the PayCloud return (see below) brings the
            live screen — and the Top Up sheet on it — back to the front rather than
            building a second copy behind the sheet that was already waiting.
        -->
        <activity
            android:name=".ui.wallet.WalletActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Where PayCloud sends the browser back to after a wallet top-up. Exported
            because the browser has to be able to reach it; it finishes immediately and
            reads nothing from the intent, so it grants no caller anything (see
            TopupReturnActivity). noHistory keeps it off the back stack.
        -->
        <activity
            android:name=".ui.wallet.TopupReturnActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anokix" android:host="topup-return" />
            </intent-filter>
        </activity>
    </application>

</manifest>
